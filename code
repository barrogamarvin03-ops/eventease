    def validate_contact_number(contact_text):
        """Require a contact number made of exactly 11 digits."""
        value = str(contact_text).strip()

        if not value or value.lower() == "e.g. 0917 123 4567":
            return False, "Please enter a contact number."

        if not value.isdigit():
            return False, "Contact Number must contain digits only. Do not use spaces, letters, or symbols."

        if len(value) < 11:
            return False, f"Contact Number is incomplete. You entered {len(value)} digits. It must be exactly 11 digits."

        if len(value) > 11:
            return False, f"Contact Number is too long. You entered {len(value)} digits. It must be exactly 11 digits."

        return True, None

    def validate_reservation_time(time_text):
        """Require a real clock time using Philippine local clock format."""
        value = str(time_text).strip()

        if not value or value.lower() == "e.g. 10:00 am":
            return None, "Please enter a reservation time."

        parsed = None
        # Accept normal 12-hour time such as 10:30 AM / 2:00 PM.
        # Also accept 24-hour input such as 14:00, then normalize it.
        for fmt in ("%I:%M %p", "%I:%M%p", "%H:%M"):
            try:
                parsed = datetime.strptime(value.upper(), fmt)
                break
            except ValueError:
                pass

        if parsed is None:
            return None, (
                "Invalid time. Please enter a real time, for example "
                "10:00 AM or 2:30 PM. Minutes must be from 00 to 59."
            )

        # Store/display the time consistently in 12-hour Philippine clock format.
        return parsed.strftime("%I:%M %p"), None

    def validate_reservation_date(date_text):
        """Allow today and future reservation dates only."""
        value = str(date_text).strip()

        if not value or value.lower() == "mm/dd/yyyy":
            return None, "Please enter a reservation date."

        parsed = None
        for fmt in ("%m/%d/%Y", "%m-%d-%Y", "%Y-%m-%d"):
            try:
                parsed = datetime.strptime(value, fmt).date()
                break
            except ValueError:
                pass

        if parsed is None:
            return None, "Invalid date. Please use MM/DD/YYYY, for example 10/20/2026."

        today = date.today()
        if parsed < today:
            return None, (
                f"Past dates are not allowed.\n\n"
                f"Today is {today.strftime('%B %d, %Y')}.\n"
                f"Please choose today or a future date."
            )

        return parsed, None

