        def go_today():
            state[:] = [today.year, today.month]
            render_calendar()

        def previous_month():
            y, m = state
            if (y, m) <= (today.year, today.month):
                return
            m -= 1
            if m == 0:
                m, y = 12, y - 1
            state[:] = [y, m]
            render_calendar()

        def next_month():
            y, m = state
            m += 1
            if m == 13:
                m, y = 1, y + 1
            state[:] = [y, m]
            render_calendar()

        def render_calendar():
            for widget in nav.winfo_children():
                widget.destroy()
            for widget in days_frame.winfo_children():
                widget.destroy()

            y, m = state
