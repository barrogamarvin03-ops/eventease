                bg="#EEF4FF", fg=COLOR_ACCENT,
                activebackground="#DDEAFF", relief="flat", bd=0,
                cursor="hand2", command=next_month
            ).pack(side="right")

            weekdays = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
            for col, name in enumerate(weekdays):
                days_frame.grid_columnconfigure(col, weight=1)
                tk.Label(
                    days_frame, text=name, font=("Segoe UI", 8, "bold"),
                    bg="#F4F6F8", fg=COLOR_MUTED, pady=7
                ).grid(row=0, column=col, sticky="nsew", padx=1, pady=1)

            weeks = pycalendar.monthcalendar(y, m)
            for row, week in enumerate(weeks, start=1):
                days_frame.grid_rowconfigure(row, weight=1)
                for col, day_number in enumerate(week):
                    if day_number == 0:
                        tk.Label(
                            days_frame, text="", bg="white"
                        ).grid(row=row, column=col, sticky="nsew", padx=1, pady=1)
                        continue

                    selected_date = date(y, m, day_number)
                    is_past = selected_date < today
                    is_today = selected_date == today

                    if is_past:
                        btn = tk.Button(
                            days_frame, text=str(day_number),
                            font=("Segoe UI", 10), bg="#F1F1F1", fg="#B8B8B8",
                            disabledforeground="#B8B8B8", relief="flat", bd=0,
                            state="disabled"
                        )
                    else:
                        btn = tk.Button(
                            days_frame, text=str(day_number),
                            font=("Segoe UI", 10, "bold") if is_today else ("Segoe UI", 10),
                            bg=COLOR_ACCENT if is_today else "white",
                            fg="white" if is_today else COLOR_DARK,
                            activebackground=COLOR_ACCENT_HOVER if is_today else "#EEF4FF",
                            activeforeground="white" if is_today else COLOR_ACCENT,
                            relief="flat", bd=0, cursor="hand2",
                            command=lambda d=selected_date: select_date(d)
                        )
                    btn.grid(row=row, column=col, sticky="nsew", padx=2, pady=2)

