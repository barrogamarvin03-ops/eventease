            return
        valid_contact, contact_error = validate_contact_number(contact)
        if not valid_contact:
            messagebox.showerror("Invalid Contact Number", contact_error)
            contact_entry.focus_set()
            return
        parsed_date, date_error = validate_reservation_date(date)
        if date_error:
