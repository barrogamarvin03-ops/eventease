    def _write_receipt_docx(r, file_path):
        document = docx.Document()
        document.add_heading("EVENTEASE PRO", level=1)
        document.add_paragraph("Official Reservation Receipt")

        table = document.add_table(rows=0, cols=2)
        table.style = "Light Grid Accent 1"
        rows = [
            ("Receipt No.", str(r["id"])),
            ("Customer Name", r["name"]),
            ("Contact Number", r["contact"]),
            ("Occasion", r["occasion"]),
            ("Package", r["package"]),
            ("Date", r["date"]),
            ("Time", r["time"]),
            ("Guests", str(r["guests"])),
            ("Discount Applied", f"Yes ({DISCOUNT_PERCENT}% OFF)" if r["discounted"] else "No"),
            ("Total Price", f"₱{r['price']:,.2f}"),
            ("Amount Paid", f"₱{r.get('amount_paid',0):,.2f}"),
            ("Balance", f"₱{max(0,r['price']-r.get('amount_paid',0)):,.2f}"),
            ("Payment Status", r.get("payment_status", "Unpaid")),
        ]
        for label, value in rows:
            cells = table.add_row().cells
            cells[0].text = label
            cells[1].text = value

        document.add_paragraph("")
        document.add_paragraph("Thank you for booking with EventEase Pro!")
        document.save(file_path)

