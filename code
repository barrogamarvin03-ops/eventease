    def add_payment_to_selected():
        """Add a new payment to the selected reservation without replacing previous payments."""
        selected = reservation_table.selection()
        if not selected:
            messagebox.showwarning("No Selection", "Select a reservation first.")
            return

        reservation_id = int(reservation_table.item(selected[0], "values")[0])
        r = next((res for res in reservations if res["id"] == reservation_id), None)
        if not r:
            messagebox.showerror("Error", "Reservation not found.")
            return

        total = float(r["price"])
        already_paid = float(r.get("amount_paid", 0) or 0)
        balance = max(0, total - already_paid)

        if balance <= 0:
            messagebox.showinfo("Payment Complete", "This reservation is already fully paid.")
            return

        amount = simpledialog.askfloat(
            "Add Payment",
            f"Current paid: ₱{already_paid:,.2f}\nRemaining balance: ₱{balance:,.2f}\n\nEnter the new payment amount:",
            minvalue=0.01,
            maxvalue=balance,
            parent=window
        )
        if amount is None:
            return

        new_paid = already_paid + float(amount)
        if new_paid >= total:
            status = "Paid"
            new_paid = total
        else:
            status = "Partial"

        db_cursor.execute(
            "UPDATE reservations SET amount_paid=?, payment_status=? WHERE id=?",
            (new_paid, status, reservation_id)
        )
        db_conn.commit()
        load_reservations_from_db()
        update_table()
        update_dashboard()

        messagebox.showinfo(
            "Payment Added",
            f"Payment added successfully!\n\nAdded today: ₱{amount:,.2f}\nTotal paid: ₱{new_paid:,.2f}\nRemaining balance: ₱{max(0, total-new_paid):,.2f}\nStatus: {status}"
        )

