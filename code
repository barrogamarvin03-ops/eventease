    def load_reservations_from_db():
        global reservations
        db_cursor.execute(
            "SELECT id, name, contact, occasion, package, date, time, guests, price, discounted, amount_paid, payment_status "
            "FROM reservations ORDER BY id"
        )
        rows = db_cursor.fetchall()
        reservations = [
            {
                "id": row[0], "name": row[1], "contact": row[2], "occasion": row[3],
                "package": row[4], "date": row[5], "time": row[6], "guests": row[7],
                "price": row[8], "discounted": bool(row[9]),
                "amount_paid": row[10], "payment_status": row[11]
            }
            for row in rows
        ]

    def reservation_conflict(date, time, exclude_id=None):
        db_cursor.execute(
            "SELECT id, name FROM reservations WHERE date = ? AND time = ? AND id != ?",
            (date, time, exclude_id or -1)
        )
        return db_cursor.fetchone()

    def calculate_payment(price):
        try:
            paid = float(amount_paid_entry.get().strip() or 0)
        except ValueError:
            raise ValueError("Amount paid must be a valid number.")
        if paid < 0 or paid > price:
            raise ValueError("Amount paid cannot be negative or greater than the total price.")
        status = payment_status_combo.get() or "Unpaid"
        if paid >= price:
            status = "Paid"
        elif paid > 0:
            status = "Partial"
        else:
            status = "Unpaid"
        return paid, status

    def edit_selected_reservation():
        selected = reservation_table.selection()
        if not selected:
            messagebox.showwarning("No Selection", "Select a reservation to edit first.")
            return
        reservation_id = int(reservation_table.item(selected[0], "values")[0])
        r = next((res for res in reservations if res["id"] == reservation_id), None)
        if not r:
            messagebox.showerror("Error", "Reservation not found.")
            return
        clear_fields()
        name_entry.delete(0, tk.END); name_entry.insert(0, r["name"])
        contact_entry.delete(0, tk.END); contact_entry.insert(0, r["contact"])
        occasion_combo.set(r["occasion"]); update_packages()
        package_combo.set(r["package"]); update_price_preview()
        date_entry.delete(0, tk.END); date_entry.insert(0, r["date"])
        time_entry.delete(0, tk.END); time_entry.insert(0, r["time"])
        guests_entry.delete(0, tk.END); guests_entry.insert(0, str(r["guests"]))
        discount_entry.delete(0, tk.END)
        if r["discounted"]:
            discount_entry.insert(0, DISCOUNT_CODE)
        amount_paid_entry.delete(0, tk.END); amount_paid_entry.insert(0, str(r.get("amount_paid", 0)))
        payment_status_combo.set(r.get("payment_status", "Unpaid"))
